{
  "manifest_version": 3,
  "name": "Jiji MCP Browser Bridge",
  "version": "0.1.0",
  "description": "Use your Jiji browser session with your MCP agents. No cookie export.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "storage"],
  "host_permissions": ["https://jiji.ng/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jiji MCP"
  }
}
