{
  "name": "jiji-browser-mcp",
  "version": "0.2.0",
  "description": "Extension-free Jiji MCP with browser login, seller research and locally approved chat",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "install:bridge": "node scripts/install.mjs",
    "cloud:build": "wrangler deploy --dry-run --outdir work/cloud-build",
    "cloud:deploy": "wrangler deploy",
    "companion": "node src/companion.mjs",
    "install:companion": "node scripts/install.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.64.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "miniflare": "^5.20261006.1-alpha",
    "prettier": "^3.9.10",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
