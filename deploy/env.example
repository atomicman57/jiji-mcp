# Copy to /etc/jiji-mcp/env and keep that file root:root mode 0600.
# It is not a Jiji cookie jar and it must not point at a copied Mac profile.
JIJI_SIGNIN=0
JIJI_HEADLESS=true
JIJI_CHROMIUM_PATH=/usr/bin/chromium
JIJI_BROWSER_CHANNEL=
JIJI_CHROMIUM_NO_SANDBOX=1
JIJI_BIND_HOST=127.0.0.1
JIJI_MCP_SOCKET=/data/bridge.sock
JIJI_IDENTITY_FILE=/data/relay-identity.json
JIJI_AUTO_APPROVE=false
JIJI_SEND_LOG_TEXT=false
JIJI_SEND_DEDUPE_MS=600000
# Optional. Unset means no hourly limit. Example: JIJI_HOURLY_SEND_CAP=12
# Optional notify-only push feed. Off until both URL and auth value are set.
# JIJI_PUSH_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/<uuid>
# JIJI_PUSH_WEBHOOK_AUTH_HEADER=Authorization
# JIJI_PUSH_WEBHOOK_AUTH_VALUE=Bearer <key>
# JIJI_PUSH_POLL_INTERVAL_MS=60000
# JIJI_PUSH_STATE_DIR=/data/push-notifications
# JIJI_PUSH_WEBHOOK_OUTBOX_MAX=1000
# Optional browser egress proxy (Playwright launch only, not the cloud relay).
# Unset means direct egress. Credentials may be embedded as https://USER:PASS@host:port;
# the explicit USERNAME/PASSWORD lines below override embedded values.
# JIJI_BROWSER_PROXY=https://<proxy-host>:89
# JIJI_BROWSER_PROXY_USERNAME=<service-username>
# JIJI_BROWSER_PROXY_PASSWORD=<service-password>
JIJI_VNC_PORT=5900
