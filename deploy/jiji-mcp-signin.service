[Unit]
Description=One-time Jiji sign-in display for the MCP companion
After=docker.service network-online.target
Requires=docker.service
Conflicts=jiji-mcp.service

[Service]
Type=simple
EnvironmentFile=/etc/jiji-mcp/env
ExecStartPre=/usr/local/sbin/jiji-mcp-init-data
ExecStartPre=/usr/bin/docker rm -f jiji-mcp-signin
ExecStart=/usr/bin/docker run --name jiji-mcp-signin --rm --read-only --cap-drop=ALL --security-opt no-new-privileges:true --user 950:950 --network host --tmpfs /tmp:rw,nosuid,size=512m --shm-size=1g -v /var/lib/jiji-mcp:/data --env-file /etc/jiji-mcp/env -e JIJI_SIGNIN=1 -e JIJI_HEADLESS=false jiji-mcp:local
ExecStop=/usr/bin/docker stop jiji-mcp-signin
ExecStopPost=-/bin/rm -f /var/lib/jiji-mcp/vnc-password
RuntimeMaxSec=1800
