{
  "triggers": { "crons": ["17 * * * *"] },
  "name": "jiji-browser-mcp",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [
    {
      "binding": "MCP_STORAGE",
      "database_name": "jiji-browser-mcp-storage",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "BRIDGES", "class_name": "JijiBridge" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JijiBridge"] }],
}
